{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard",
  "type": "object",
  "required": [
    "productionId",
    "version",
    "scenes"
  ],
  "properties": {
    "productionId": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose",
          "durationSeconds",
          "narration",
          "scenePatternId",
          "assetRequests",
          "editingIntents"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "durationSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "narration": {
            "type": "string"
          },
          "scenePatternId": {
            "type": "string"
          },
          "visual": {
            "type": "object",
            "properties": {
              "headline": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "assetRefs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "background": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "assetRequests": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "editingIntents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
