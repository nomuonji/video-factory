    {
      "id": "s3",
      "purpose": "4ステップで理解",
      "durationSeconds": 30,
      "narration": "流れは四段階です。まずアプリが認可画面へ案内し、利用者が渡す権限を確認して許可します。すると認可コードが返ります。アプリはそのコードを認可サーバーへ送り、アクセストークンと交換します。以後はそのトークンを使い、許可された範囲だけAPIへアクセスします。大事なのは、パスワード自体をアプリへ渡していないことです。",
      "scenePatternId": "narrated-diagram",
      "visual": {
        "headline": "OAuth の基本フロー",
        "steps": [
          "アプリ",
          "認可画面",
          "認可コード",
          "アクセストークン"
        ],
        "body": "パスワードそのものをアプリへ渡さない"
      },
      "assetRequests": [
        {
          "capabilityId": "diagram",
          "brief": "Authorization flow"
        },
        {
          "capabilityId": "narration",
          "brief": "Continue narration"
        },
        {
          "capabilityId": "subtitle",
          "brief": "Timed Japanese captions from the scene narration"
        }
      ],
      "editingIntents": [
        "process",
        "explanation"
      ]
    },
    {
      "id": "s4",
      "purpose": "まとめ",
      "durationSeconds": 14,
      "narration": "覚えるのは二つです。OAuthはパスワード共有ではなく権限の委任。そして実際のアクセスには、許可範囲が限定されたアクセストークンを使います。",
      "scenePatternId": "outro",
