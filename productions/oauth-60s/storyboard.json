      "id": "s2",
      "purpose": "OAuthとは",
      "durationSeconds": 10,
      "narration": "写真アプリにGoogleのパスワードを教えず、画像を読む権限だけ許可できます。OAuthはログインではなく、権限の委任です。",
      "scenePatternId": "definition-card",
      "visual": {
        "headline": "OAuth",
        "body": "アクセス権を委任する仕組み"
      },
      "assetRequests": [
