    "prepare": "tsx tools/prepare-production.ts",
    "render": "tsx tools/render-production.ts",
    "studio": "remotion studio renderer/remotion/index.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.530",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
